# Required to start the HTTP server.
PORT=3000

# PostgreSQL connection string used by the schema-backed API.
DATABASE_URL=

# Logging and runtime settings.
NODE_ENV=development
LOG_LEVEL=info

# Optional public scanner configuration. Use comma-separated name=https://host entries.
GENESIS_PUBLIC_SCANNERS=

# Chain integration settings. Replace every placeholder before enabling chain routes.
GENESIS_ROBINHOOD_RPC_URL=https://example.invalid/rpc
ROBINHOOD_RPC_URL=https://example.invalid/rpc
GENESIS_V2_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
GENESIS_V2_FACTORY_ADDRESS=0x0000000000000000000000000000000000000000
GENESIS_V2_COORDINATOR_ADDRESS=0x0000000000000000000000000000000000000000
GENESIS_V2_PROTOCOL_ADDRESS=0x0000000000000000000000000000000000000000
GENESIS_V2_WETH_ADDRESS=0x0000000000000000000000000000000000000000
GENESIS_V2_POOL_MANAGER_ADDRESS=0x0000000000000000000000000000000000000000
GENESIS_V2_POSITION_MANAGER_ADDRESS=0x0000000000000000000000000000000000000000

# Optional legacy routing/artifact variables. Leave unset unless explicitly reviewed.
GENESIS_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
GENESIS_FACTORY_ADDRESS=0x0000000000000000000000000000000000000000
GENESIS_COORDINATOR_ADDRESS=0x0000000000000000000000000000000000000000
GENESIS_PROTOCOL_ADDRESS=0x0000000000000000000000000000000000000000
GENESIS_WETH_ADDRESS=0x0000000000000000000000000000000000000000
GENESIS_V1_HOOK_ARTIFACT_PATH=./path/to/reviewed-hook.json
GENESIS_V1_LOCK_ARTIFACT_PATH=./path/to/reviewed-lock.json
GENESIS_V2_HOOK_ARTIFACT_PATH=./path/to/reviewed-hook.json
GENESIS_V2_LOCK_ARTIFACT_PATH=./path/to/reviewed-lock.json

# Optional artifact upload integration. Never commit a real token.
PINATA_JWT=replace-with-a-local-development-token

# Required only for deployment-proof issuance. Keep this in a secret manager.
GENESIS_VERIFIER_PRIVATE_KEY=replace-with-a-development-key